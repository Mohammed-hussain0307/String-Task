package stringTask;

import java.util.Arrays;

public class SwapString {

	public static void main(String[] args) {
		
		String ar[] = {"hi","app","day","bag","cat","eat","zoo","fan","yellow","goat"};
		Arrays.sort(ar);
		System.out.println(Arrays.toString(ar));
		
		int i=0;
		
		while(i<ar.length) {
			
			String s = ar[ar.length-1];
			
			for(int j=ar.length-1;j>i;j--) {
				
				ar[j] = ar[j-1];
			}
			
			ar[i] = s;
			i+=2;
		}
		
		System.out.println(Arrays.toString(ar));
	}

}
